{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "md-view",
  "version": "0.3.0",
  "identifier": "com.mdview.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "md-view",
        "width": 1180,
        "height": 780,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https: http:; media-src 'self' asset: http://asset.localhost data: blob: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Markdown viewer and editor",
    "longDescription": "Read and edit Markdown files with a GitHub-style preview: tables, LaTeX formulas, Mermaid diagrams, animated SVG and images.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdx"
        ],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0 | libgtk-3-0t64"
        ],
        "desktopTemplate": "linux/md-view.desktop",
        "files": {
          "/usr/share/metainfo/com.mdview.desktop.metainfo.xml": "linux/com.mdview.desktop.metainfo.xml",
          "/usr/share/doc/md-view/copyright": "linux/copyright"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/md-view.desktop",
        "files": {
          "/usr/share/metainfo/com.mdview.desktop.metainfo.xml": "linux/com.mdview.desktop.metainfo.xml",
          "/usr/share/licenses/md-view/LICENSE": "../LICENSE"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/com.mdview.desktop.metainfo.xml": "linux/com.mdview.desktop.metainfo.xml"
        }
      }
    }
  }
}
