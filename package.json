{
  "name": "md-view",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "description": "Minimalist Markdown viewer and editor: tables, LaTeX formulas, Mermaid diagrams, SVG and GitHub-style code highlighting.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "versions": "node scripts/check-versions.mjs",
    "notices": "node scripts/third-party.mjs",
    "icons": "python3 scripts/generate-icons.py",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "release": "bash scripts/release.sh",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changelog": "node scripts/changelog.mjs generate",
    "promo": "node scripts/promo/record.mjs",
    "promo:webp": "node scripts/promo/webp.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@vscode/markdown-it-katex": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dom-to-svg": "^0.12.2",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "markdown-it": "^15.0.2",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.0.0",
    "modern-screenshot": "^4.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ffmpeg-static": "^5.3.0",
    "oxlint": "^1.86.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "homepage": "https://jigonzalez930209.github.io/md-view/",
  "repository": {
    "type": "git",
    "url": "https://github.com/jigonzalez930209/md-view.git"
  },
  "bugs": {
    "url": "https://github.com/jigonzalez930209/md-view/issues"
  }
}
